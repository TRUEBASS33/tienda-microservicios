# Copia este archivo a .env y cambia los valores:  cp .env.example .env
# Si no creas .env, docker compose usa los valores por defecto (solo para desarrollo).

POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambia_esta_clave

# Secreto para firmar los tokens JWT (usa algo largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-algo-largo-y-aleatorio

# Clave para la comunicación entre microservicios
INTERNAL_KEY=cambia-esta-clave-interna

# Administrador que se crea automáticamente al iniciar
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=cambia_esta_clave_admin
